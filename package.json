{
  "name": "facilito-web",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio público de Facilito by Logic Code Spot — Santo Domingo, República Dominicana",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "lenis": "1.3.26",
    "lucide-react": "1.48.0",
    "next": "15.5.27",
    "nodemailer": "10.0.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "overrides": {
      "sharp@<0.35.5": "^0.35.5",
      "postcss@<8.5.23": "^8.5.23"
    }
  }
}
