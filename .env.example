# Public site (canonical, sitemap, Open Graph). Production: the final domain.
NEXT_PUBLIC_SITE_URL=https://facilito-web.vercel.app

# Facilito app (login / registro). The marketing site links here; it hosts no auth.
NEXT_PUBLIC_APP_URL=https://facilitord.vercel.app

# Public contact data. Leave empty to hide the email / WhatsApp buttons.
NEXT_PUBLIC_CONTACT_EMAIL=
# Digits only with country code, e.g. 18095550101
NEXT_PUBLIC_WHATSAPP_E164=

# Contact form delivery: smtp | sink (sink only logs; use it in tests)
CONTACT_DELIVERY=smtp
CONTACT_TO_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=
MAIL_REPLY_TO=

# Optional shared rate limit. Without these the limit is per-instance (in memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
